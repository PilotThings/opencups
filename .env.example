# --- PostgreSQL (docker compose + server) ---
POSTGRES_DB=opencups
POSTGRES_USER=opencups
POSTGRES_PASSWORD=opencups
POSTGRES_PORT=5434
DATABASE_URL=postgres://opencups:opencups@localhost:5434/opencups

# --- Server ---
# Admin UI + REST API
HTTP_PORT=8080
# CUPS endpoint (HTTPS, what Basics Station connects to)
CUPS_PORT=6040
# Optional: when set, every /api call needs "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=
# Days of CUPS request history to keep
REQUEST_RETENTION_DAYS=90
